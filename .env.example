APP_NAME=Waternet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://waternet.uz

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=waternet
DB_USERNAME=root
DB_PASSWORD=

# Redis — cache, session, queue uchun ishlatiladi
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Cache: file | redis | database
CACHE_DRIVER=redis
CACHE_PREFIX=waternet_cache

# Session: file | redis | database | cookie
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Queue: sync | redis | database
QUEUE_CONNECTION=redis
REDIS_QUEUE=default

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# Yandex Maps (https://developer.tech.yandex.ru dan bepul API key olish mumkin)
YANDEX_MAPS_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ASYNC_REQUESTS=false

# JWT
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
