{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Laravel Dev Server",
      "runtimeExecutable": "php",
      "runtimeArgs": ["artisan", "serve", "--port=8000"],
      "port": 8000
    },
    {
      "name": "Laravel Mix Watch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "watch"],
      "port": 8080
    },
    {
      "name": "waternet-driver",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "waternet-driver", "run", "dev"],
      "port": 5174
    }
  ]
}
